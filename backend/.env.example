# =============================================================================
# Paper Reader — Backend Environment Variables / 后端环境变量
# Copy to .env and fill in your values / 复制为 .env 并填入实际值
# =============================================================================

# --- Application / 应用配置 ---
SPRING_PROFILES_ACTIVE=development  # dev | prod
SERVER_PORT=8080                    # 服务端口 / Server port
LOG_LEVEL=INFO                      # 日志级别: TRACE, DEBUG, INFO, WARN, ERROR

# --- Database / 数据库 (PostgreSQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=paper_reader
DATABASE_USER=paper_reader
DATABASE_PASSWORD=changeme

# --- Redis / 缓存 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT / 令牌认证 ---
# 密钥至少 256 位，生产环境务必更换 / Minimum 256-bit key, must change in production
JWT_SECRET=changeme-generate-a-random-256-bit-key
# Access token 有效期，单位毫秒（默认 1 小时）/ Access token TTL in ms (default 1 hour)
JWT_ACCESS_EXPIRATION=3600000
# Refresh token 有效期，单位毫秒（默认 7 天）/ Refresh token TTL in ms (default 7 days)
JWT_REFRESH_EXPIRATION=604800000

# --- Storage / 文件存储 ---
# 存储类型: dufs | local / Storage backend: dufs or local
STORAGE_TYPE=dufs
STORAGE_LOCAL_PATH=./uploads

# --- Dufs / Dufs 文件服务器 ---
DUFS_URL=http://localhost:8400

# --- GROBID / 论文解析服务 ---
GROBID_BASE_URL=http://localhost:8070
# 请求超时，单位毫秒 / Request timeout in ms
GROBID_TIMEOUT=60000

# --- Email / 邮件 ---
MAIL_FROM=noreply@yourdomain.com

# --- GitHub OAuth / GitHub 第三方登录 ---
# 从 GitHub Developer Settings 获取 / Obtain from GitHub Developer Settings
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AI — OpenAI / OpenAI 大模型 ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- AI — Claude / Claude 大模型 ---
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- AI — DeepSeek / DeepSeek 大模型 ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- AI — Qwen / 通义千问大模型 ---
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
