# =============================================================================
# Paper Reader — Frontend Environment Variables / 前端环境变量
# Copy to .env.local and fill in your values / 复制为 .env.local 并填入实际值
# =============================================================================

# --- Backend API / 后端 API 地址 ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# --- Auth / 认证开关 ---
# 设为 false 则跳过登录，直接进入首页 / Set false to skip login and go directly to home
NEXT_PUBLIC_AUTH_ENABLED=true

# --- GitHub OAuth / GitHub 第三方登录 ---
# 留空则登录页只显示邮箱密码登录 / Leave empty to show only email+password login
NEXT_PUBLIC_GITHUB_CLIENT_ID=
# 回调地址必须与 GitHub OAuth App 中配置的一致 / Must match the callback URL set in GitHub OAuth App
NEXT_PUBLIC_GITHUB_REDIRECT_URI=http://localhost:3001/callback

# --- Feature Flags / 功能开关 ---
# 是否启用 AI 对话功能 / Enable AI chat feature
NEXT_PUBLIC_ENABLE_AI_CHAT=true
